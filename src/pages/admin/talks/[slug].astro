---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import TalkForm from '../../../components/admin/TalkForm.astro';
import { getFile } from '../../../lib/github';
import { TALKS_DIR, validSlug, ymd } from '../../../lib/cms/content';
import matter from 'gray-matter';

const { slug } = Astro.params;
if (!validSlug(slug)) return Astro.redirect('/admin/talks');

const file = await getFile(`${TALKS_DIR}/${slug}.md`);
if (!file) return Astro.redirect('/admin/talks');
const data = matter(file.content).data;
const talk = { ...data, date: data.date ? ymd(data.date) : '' };
---

<AdminLayout title={`Edit: ${talk.presentation}`} activeSection="talks">
  <Fragment slot="breadcrumb">
    <a href="/admin">Dashboard</a>
    <span class="cms-breadcrumb-sep">/</span>
    <a href="/admin/talks">Talks</a>
    <span class="cms-breadcrumb-sep">/</span>
    <span class="cms-breadcrumb-current">{talk.presentation}</span>
  </Fragment>

  <div class="cms-page-header">
    <div>
      <h1 class="cms-page-title">Edit Talk</h1>
      <p class="cms-page-subtitle">{talk.presentation}</p>
    </div>
  </div>

  <TalkForm mode="edit" slug={slug} sha={file.sha} talk={talk} />
</AdminLayout>
