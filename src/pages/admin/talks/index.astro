---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Talks" activeSection="talks">
  <Fragment slot="breadcrumb">
    <a href="/admin">Dashboard</a>
    <span class="cms-breadcrumb-sep">/</span>
    <span class="cms-breadcrumb-current">Talks</span>
  </Fragment>

  <Fragment slot="actions">
    <a href="/admin/talks/new" class="cms-btn cms-btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Talk
    </a>
  </Fragment>

  <div class="cms-page-header">
    <div>
      <h1 class="cms-page-title">Talks & Presentations</h1>
      <p class="cms-page-subtitle" id="talk-count"></p>
    </div>
  </div>

  <div class="list-controls">
    <input class="cms-input" type="search" id="q" placeholder="Search talks and conferences  ( / )" aria-label="Search talks" />
    <select class="cms-select" id="region" aria-label="Region">
      <option value="">All regions</option>
      <option>NA</option><option>EMEA</option><option>APAC</option><option>LATAM</option><option>Global</option>
    </select>
  </div>

  <div id="talks-container">
    <div class="cms-loading-overlay">
      <div class="cms-spinner"></div>
      <span>Loading talks...</span>
    </div>
  </div>

  <style>
    .list-controls { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
    .list-controls .cms-input { flex: 1; min-width: 220px; }
    .list-controls .cms-select { width: auto; min-width: 140px; }
    :global(.talk-title) { color: var(--cms-text); text-decoration: none; font-weight: 500; }
    :global(.talk-title:hover) { text-decoration: underline; }
    :global(.cms-table td.title-cell) { max-width: 420px; white-space: normal; }
    :global(.no-video) { font-size: 11px; color: var(--cms-warning); margin-left: 6px; }
  </style>

  <script>
    import { api, esc, fmtDate, toast, watchDeploy } from '../../../scripts/admin/cms';

    type Talk = { slug: string; presentation: string; conference: string; region: string; date: string; link: string; sha: string };
    let talks: Talk[] = [];
    const state = { q: '', region: '' };
    const container = document.getElementById('talks-container')!;
    const pending = new Set<string>();
    const isVideo = (l: string) => /youtube\.com|youtu\.be/.test(l || '');

    async function load() {
      try {
        talks = await api<Talk[]>('/api/admin/talks');
        render();
      } catch (err) {
        container.innerHTML = `<div class="cms-empty"><div class="cms-empty-text">Failed to load talks</div><div class="cms-empty-text">${esc((err as Error).message)}</div></div>`;
      }
    }

    function render() {
      const years = new Set(talks.map((t) => t.date.slice(0, 4)));
      document.getElementById('talk-count')!.textContent = `${talks.length} talks across ${years.size} years`;
      const q = state.q.toLowerCase();
      const shown = talks.filter((t) => (!state.region || t.region === state.region) && (!q || `${t.presentation} ${t.conference}`.toLowerCase().includes(q)));
      if (!shown.length) {
        container.innerHTML = `<div class="cms-empty"><div class="cms-empty-text">${talks.length ? 'No talks match.' : 'No talks yet.'}</div></div>`;
        return;
      }
      container.innerHTML = `
        <div class="cms-table-wrap">
          <table class="cms-table">
            <thead><tr><th>Presentation</th><th>Conference</th><th>Region</th><th>Date</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody>
              ${shown.map((t) => `
                <tr>
                  <td class="title-cell"><a class="talk-title" href="/admin/talks/${esc(t.slug)}">${esc(t.presentation)}</a>${isVideo(t.link) ? '' : '<span class="no-video">no video</span>'}</td>
                  <td>${esc(t.conference)}</td>
                  <td><span class="cms-badge cms-badge-gray">${esc(t.region)}</span></td>
                  <td>${esc(fmtDate(t.date))}</td>
                  <td>
                    <div class="cms-actions">
                      <a href="${esc(t.link)}" target="_blank" rel="noopener" class="cms-btn cms-btn-ghost cms-btn-sm">Open</a>
                      <a href="/admin/talks/${esc(t.slug)}" class="cms-btn cms-btn-ghost cms-btn-sm">Edit</a>
                      <button type="button" data-delete="${esc(t.slug)}" class="cms-btn cms-btn-danger cms-btn-sm">${pending.has(t.slug) ? 'Confirm' : 'Delete'}</button>
                    </div>
                  </td>
                </tr>`).join('')}
            </tbody>
          </table>
        </div>`;
    }

    container.addEventListener('click', async (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-delete]');
      if (!btn) return;
      const slug = btn.dataset.delete!;
      if (!pending.has(slug)) {
        pending.add(slug);
        render();
        setTimeout(() => { pending.delete(slug); render(); }, 4000);
        return;
      }
      pending.delete(slug);
      const talk = talks.find((t) => t.slug === slug);
      if (!talk) return;
      try {
        const res = await api<{ commit: string }>('/api/admin/talks', { method: 'DELETE', json: { slug, sha: talk.sha } });
        talks = talks.filter((t) => t.slug !== slug);
        watchDeploy(res.commit, '/talks/');
        toast(`Deleted "${talk.presentation}"`, 'success');
        render();
      } catch (err) {
        toast((err as Error).message, 'error');
      }
    });

    const q = document.getElementById('q') as HTMLInputElement;
    q.addEventListener('input', () => { state.q = q.value; render(); });
    document.getElementById('region')!.addEventListener('change', (e) => { state.region = (e.target as HTMLSelectElement).value; render(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName || '')) {
        e.preventDefault();
        q.focus();
      }
    });

    load();
  </script>
</AdminLayout>
