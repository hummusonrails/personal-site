---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Blog Posts" activeSection="blog">
  <Fragment slot="breadcrumb">
    <a href="/admin">Dashboard</a>
    <span class="cms-breadcrumb-sep">/</span>
    <span class="cms-breadcrumb-current">Blog Posts</span>
  </Fragment>

  <Fragment slot="actions">
    <a href="/admin/blog/new" class="cms-btn cms-btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Post
    </a>
  </Fragment>

  <div class="cms-page-header">
    <div>
      <h1 class="cms-page-title">Blog Posts</h1>
      <p class="cms-page-subtitle" id="post-count"></p>
    </div>
  </div>

  <div class="list-controls">
    <input class="cms-input" type="search" id="q" placeholder="Search titles, summaries and slugs  ( / )" aria-label="Search posts" />
    <div class="seg" id="status" role="radiogroup" aria-label="Status">
      <button type="button" data-status="all" aria-checked="true" role="radio">All</button>
      <button type="button" data-status="published" aria-checked="false" role="radio">Published</button>
      <button type="button" data-status="draft" aria-checked="false" role="radio">Drafts</button>
    </div>
    <select class="cms-select" id="tag" aria-label="Tag"><option value="">All tags</option></select>
  </div>

  <div id="posts-container">
    <div class="cms-loading-overlay">
      <div class="cms-spinner"></div>
      <span>Loading posts...</span>
    </div>
  </div>

  <style>
    .list-controls { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
    .list-controls .cms-input { flex: 1; min-width: 220px; }
    .list-controls .cms-select { width: auto; min-width: 140px; }
    .seg { display: inline-flex; gap: 2px; padding: 2px; background: var(--cms-card); border: 1px solid var(--cms-border); border-radius: 8px; }
    .seg button { border: 0; background: none; color: var(--cms-text-secondary); font: 500 13px var(--cms-font); padding: 6px 12px; border-radius: 6px; cursor: pointer; }
    .seg button[aria-checked='true'] { background: var(--cms-border); color: var(--cms-text); }
    :global(.post-title) { color: var(--cms-text); text-decoration: none; font-weight: 500; }
    :global(.post-title:hover) { text-decoration: underline; }
    :global(.post-sub) { display: block; font-size: 12.5px; color: var(--cms-text-muted); font-weight: 400; overflow: hidden; text-overflow: ellipsis; }
    :global(.post-tags) { display: flex; gap: 4px; flex-wrap: wrap; }
    :global(.post-tags span) { font-size: 11px; padding: 1px 7px; border-radius: 999px; background: var(--cms-border); color: var(--cms-text-secondary); }
    :global(.cms-table td.title-cell) { max-width: 460px; white-space: normal; }
    :global(.cms-table td.num) { font-variant-numeric: tabular-nums; }
  </style>

  <script>
    import { api, esc, fmtDate, toast, watchDeploy } from '../../../scripts/admin/cms';

    type Post = { slug: string; title: string; date: string; draft: boolean; tags: string[]; summary: string; words: number; sha: string };
    let posts: Post[] = [];
    const state = { q: '', status: 'all', tag: '' };
    const container = document.getElementById('posts-container')!;
    const pending = new Set<string>();

    async function load() {
      try {
        posts = await api<Post[]>('/api/admin/blog');
        const tags = [...new Set(posts.flatMap((p) => p.tags))].sort();
        const sel = document.getElementById('tag') as HTMLSelectElement;
        sel.innerHTML = '<option value="">All tags</option>' + tags.map((t) => `<option value="${esc(t)}">${esc(t)}</option>`).join('');
        sel.value = state.tag;
        render();
      } catch (err) {
        container.innerHTML = `<div class="cms-empty"><div class="cms-empty-text">Failed to load posts</div><div class="cms-empty-text">${esc((err as Error).message)}</div></div>`;
      }
    }

    function render() {
      const drafts = posts.filter((p) => p.draft).length;
      document.getElementById('post-count')!.textContent =
        `${posts.length} posts · ${posts.length - drafts} published · ${drafts} draft${drafts === 1 ? '' : 's'}`;
      const q = state.q.toLowerCase();
      const shown = posts.filter((p) =>
        (state.status === 'all' || (state.status === 'draft') === p.draft) &&
        (!state.tag || p.tags.includes(state.tag)) &&
        (!q || `${p.title} ${p.summary} ${p.slug}`.toLowerCase().includes(q)));

      if (!posts.length) {
        container.innerHTML = `<div class="cms-empty"><div class="cms-empty-text">No blog posts yet.</div><a href="/admin/blog/new" class="cms-btn cms-btn-primary">New Post</a></div>`;
        return;
      }
      if (!shown.length) {
        container.innerHTML = `<div class="cms-empty"><div class="cms-empty-text">No posts match.</div></div>`;
        return;
      }
      container.innerHTML = `
        <div class="cms-table-wrap">
          <table class="cms-table">
            <thead><tr><th>Title</th><th>Date</th><th>Tags</th><th>Words</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody>
              ${shown.map((p) => `
                <tr>
                  <td class="title-cell"><a class="post-title" href="/admin/blog/${esc(p.slug)}">${esc(p.title)}</a><span class="post-sub">/blog/${esc(p.slug)}/</span></td>
                  <td>${esc(fmtDate(p.date))}</td>
                  <td><div class="post-tags">${p.tags.map((t) => `<span>${esc(t)}</span>`).join('')}</div></td>
                  <td class="num">${p.words.toLocaleString()}</td>
                  <td><span class="cms-badge ${p.draft ? 'cms-badge-yellow' : 'cms-badge-green'}">${p.draft ? 'Draft' : 'Published'}</span></td>
                  <td>
                    <div class="cms-actions">
                      ${p.draft ? '' : `<a href="https://www.bengreenberg.dev/blog/${esc(p.slug)}/" target="_blank" rel="noopener" class="cms-btn cms-btn-ghost cms-btn-sm">View</a>`}
                      <a href="/admin/blog/${esc(p.slug)}" class="cms-btn cms-btn-ghost cms-btn-sm">Edit</a>
                      <button type="button" data-delete="${esc(p.slug)}" class="cms-btn cms-btn-danger cms-btn-sm">${pending.has(p.slug) ? 'Confirm' : 'Delete'}</button>
                    </div>
                  </td>
                </tr>`).join('')}
            </tbody>
          </table>
        </div>`;
    }

    // Delete asks twice inline instead of with a dialog.
    container.addEventListener('click', async (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-delete]');
      if (!btn) return;
      const slug = btn.dataset.delete!;
      if (!pending.has(slug)) {
        pending.add(slug);
        render();
        setTimeout(() => { pending.delete(slug); render(); }, 4000);
        return;
      }
      pending.delete(slug);
      const post = posts.find((p) => p.slug === slug);
      if (!post) return;
      try {
        const res = await api<{ commit: string }>('/api/admin/blog', { method: 'DELETE', json: { slug, sha: post.sha } });
        posts = posts.filter((p) => p.slug !== slug);
        watchDeploy(res.commit);
        toast(`Deleted "${post.title}"`, 'success');
        render();
      } catch (err) {
        toast((err as Error).message, 'error');
      }
    });

    const q = document.getElementById('q') as HTMLInputElement;
    q.addEventListener('input', () => { state.q = q.value; render(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        q.focus();
      }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((b) => b.addEventListener('click', () => {
      state.status = b.dataset.status!;
      document.querySelectorAll('[data-status]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      render();
    }));
    document.getElementById('tag')!.addEventListener('change', (e) => { state.tag = (e.target as HTMLSelectElement).value; render(); });

    load();
  </script>
</AdminLayout>
